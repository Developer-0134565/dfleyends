---

/**
 * Portada de DF Legends: IDENTIDAD + ENTRADA.
 *
 * La portada conserva su caracter de presentaciÃ³n (piedra, pergamino, latÃ³n) y,
 * ademÃ¡s, ofrece el acceso a la aplicaciÃ³n. El botÃ³n principal apunta a
 * `/world`, que es la vista que consume la API.
 *
 * En el build pÃºblico sin API, la portada sigue siendo una portada: los enlaces
 * de datos llevan a vistas que mostrarÃ¡n "Data unavailable" con claridad, en
 * lugar de fingir que hay un mundo cargado.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhatIs from '../components/WhatIs.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Philosophy from '../components/Philosophy.astro';
import Roadmap from '../components/Roadmap.astro';
---


<BaseLayout
  title="DF Legends â€” Explore the History of Your Dwarf Fortress Worlds"
  description="Explore historical figures, civilizations, sites, events and geography generated by Dwarf Fortress."
>
  <Hero />

  <section class="container entrada" aria-labelledby="entrada-titulo">
    <h2 id="entrada-titulo">Open the world</h2>
    <p>
      Browse the figures, entities, sites, artifacts and events of a loaded
      Dwarf Fortress world. Every figure comes from the data: nothing is
      generated, and what is unknown is shown as unknown.
    </p>
    <p class="acciones">
      <a class="boton boton--principal" href="/app/world">Explore World</a>
      <a class="boton" href="/app/figures">Figures</a>
      <a class="boton" href="/app/entities">Entities</a>
      <a class="boton" href="/app/sites">Sites</a>
      <a class="boton" href="/app/artifacts">Artifacts</a>
      <a class="boton" href="/app/events">Events</a>
      <a class="boton" href="/app/timeline">Timeline</a>
      <a class="boton" href="/app/geography">Geography</a>
    </p>
  </section>

  <WhatIs />
  <Features />
  <HowItWorks />
  <Philosophy />
  <Roadmap />
</BaseLayout>

<!--
  Router de datos en la portada.

  Las rutas limpias (`/figures/712`) las sirve `404.html`; `/app/...` las sirve
  `app/index.html`. Ambas usan el MISMO script, importado aqui para que este
  tambien funcione si alguien llega a una ruta de datos por la portada.
-->
<script>
  import '../lib/vistas';
</script>

<style>
  .entrada {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line-soft);
  }

  .entrada h2 {
    font-size: clamp(1.5rem, 3.6vw, 2.1rem);
    margin-bottom: 0.5rem;
  }

  .entrada p {
    color: var(--ink-dim);
    max-width: 46rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .boton {
    display: inline-block;
    padding: 0.55rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--ink-dim);
  }

  .boton:hover {
    border-color: var(--brass);
    color: var(--brass-hi);
  }

  .boton--principal {
    border-color: var(--brass);
    background: color-mix(in srgb, var(--brass) 18%, var(--stone-800));
    color: var(--brass-hi);
    font-weight: 600;
  }
</style>