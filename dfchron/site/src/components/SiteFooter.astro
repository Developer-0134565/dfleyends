---
/**
 * Pie sobrio. Sin enlaces externos: no hay URL de repositorio verificada en el
 * proyecto, y publicar una inventada seria un enlace roto. Solo anclas reales.
 */
const links = [
  { href: '#features', label: 'Features' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#philosophy', label: 'Philosophy' },
  { href: '#roadmap', label: 'Roadmap' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">DF Legends</p>
        <p class="footer-tag">
          Explore the history generated by your Dwarf Fortress worlds.
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="footer-h">Sections</h2>
        <ul>
          {links.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>Independent project. Not affiliated with Bay 12 Games.</span>
      <span>Dwarf Fortress is created by Bay 12 Games.</span>
    </div>
  </div>
</footer>