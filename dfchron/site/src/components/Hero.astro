---
/**
 * Hero.
 *
 * Dos acciones y ninguna-promesa:
 *  - "Explore a World" es un ancla real a #features.
 *  - "Download DF Legends" va deshabilitado: no existe todavia un ejecutable
 *    publico, y enlazar a un fichero inexistente seria un enlace roto.
 */
---

<section class="hero">
  <div class="container hero-inner">
    <svg
      class="hero-mark"
      viewBox="0 0 32 32"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M3 11c5-6 21-6 26 0"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
      <path d="M16 9v19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>

    <p class="eyebrow">Dwarf Fortress · Legends</p>

    <h1>DF Legends</h1>

    <p class="tagline">Explore the history of your Dwarf Fortress worlds.</p>

    <p class="lede">
      Turn the history generated by Dwarf Fortress into something you can
      explore, search and understand.
    </p>

    <div class="actions">
      <a class="btn btn-primary" href="#features">Explore a World</a>
      <button
        class="btn btn-ghost"
        type="button"
        disabled
        aria-describedby="download-note">Download DF Legends</button>
    </div>

    <p class="actions-note" id="download-note">
      The standalone build is not public yet. <a href="#roadmap">See what is planned</a>.
    </p>

    <div class="hero-rule" aria-hidden="true"></div>
  </div>
</section>