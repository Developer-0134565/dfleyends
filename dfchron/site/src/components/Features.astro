---
/**
 * Caracteristicas.
 *
 * Iconos SVG en linea (24x24, `currentColor`). Sin librerias de iconos y sin
 * peticiones de red: el sitio se ve igual sin conexion.
 *
 * Los textos van deliberadamente en clave "available / recorded" (datos
 * disponibles, historia registrada): ninguna de estas areas es la totalidad
 * del mundo.
 */
const features = [
  {
    title: 'Historical Figures',
    body: 'Explore historical figures generated by the world, and the recorded lives that shaped it.',
    icon: '<circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c0-3.6 2.9-5.8 6.5-5.8s6.5 2.2 6.5 5.8"/>',
  },
  {
    title: 'Civilizations',
    body: 'Explore civilizations and historical entities, and the span of their recorded history.',
    icon: '<path d="M6 21V3.5"/><path d="M6 4.5h11.5l-2.2 3.6 2.2 3.6H6z"/>',
  },
  {
    title: 'Sites',
    body: 'Discover settlements and other historical sites recorded in the world’s history.',
    icon: '<path d="M2.5 19.5h19"/><path d="M4.5 19.5 9.2 10.8l3.1 5 2.2-2.9 5 6.6"/><path d="M7.5 19.5v-3h3v3"/>',
  },
  {
    title: 'Historical Events',
    body: 'Explore events recorded by the world’s history, from first foundations to final defeats.',
    icon: '<path d="M6.5 3h8L18.5 7v14h-12z"/><path d="M14.5 3v4h4"/><path d="M9.5 12h6M9.5 15.5h6"/>',
  },
  {
    title: 'Relationships',
    body: 'Follow connections between historical figures and events where the available data supports them.',
    icon: '<circle cx="6" cy="6.5" r="2.4"/><circle cx="18" cy="6.5" r="2.4"/><circle cx="12" cy="18" r="2.4"/><path d="M7.7 8.1 10.8 16.2M16.3 8.1 13.2 16.2M8.5 6.5h7"/>',
  },
  {
    title: 'Geography',
    body: 'Explore available rivers, landmasses, mountain peaks and world constructions.',
    icon: '<path d="M9 4 3 6.6v13.4L9 17.4l6 2.6 6-2.6V4l-6 2.6z"/><path d="M9 4v13.4M15 6.6V20"/>',
  },
];
---

<section class="section" id="features" aria-labelledby="features-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">What you can explore</p>
      <h2 id="features-heading">Recorded history, broken down</h2>
      <p>
        Every area below reflects what Dwarf Fortress writes into the world’s
        history file. Coverage varies from world to world and depends on how
        much of that history was generated — these are the available data, not
        a complete picture of every world.
      </p>
    </div>

    <div class="feature-grid">
      {
        features.map((f) => (
          <article class="feature">
            <svg
              class="feature-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
              set:html={f.icon}
            />
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>